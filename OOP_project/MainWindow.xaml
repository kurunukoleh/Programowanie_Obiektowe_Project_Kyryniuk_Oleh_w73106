<Window x:Class="Programowanie_Obiektowe_Project_Kyryniuk_Oleh_w73106.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaForge — Language Library"
        Height="680" Width="950"
        MinHeight="520" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Loaded="LibraryWindow_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Language Library"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,16" Grid.ColumnSpan="2"/>

        <TabControl x:Name="LibraryTabs"
                    SelectionChanged="LibraryTabs_SelectionChanged" Grid.ColumnSpan="2" Margin="0,53,0,0" Grid.RowSpan="2">

            <!-- LETTERS -->
            <TabItem Header="Letters">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="LettersGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Symbol"/>
                        <TextBox x:Name="LetterTextBox"
                                 Margin="0,4,0,8"
                                 MaxLength="20"/>

                        <TextBlock Text="Category"/>
                        <ComboBox x:Name="LetterCategoryComboBox"
                                  Margin="0,4,0,0">
                            <ComboBoxItem Content="Vowel"/>
                            <ComboBoxItem Content="Consonant"/>
                            <ComboBoxItem Content="Affricate"/>
                            <ComboBoxItem Content="Diphthong"/>
                            <ComboBoxItem Content="Modifier"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Add"
                                Click="AddLetter_Click"
                                Padding="18,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Delete selected"
                                Click="DeleteLetter_Click"
                                Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>



            <!-- FORMS -->
            <TabItem Header="Forms">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FormsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">   
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Word"
                            Binding="{Binding Word}"
                            Width="*" />

                            <DataGridTextColumn Header="Grammatical role"
                            Binding="{Binding GrammaticalRole}"
                            Width="*" />

                            <DataGridTextColumn Header="Root translation"
                            Binding="{Binding RootTranslation}"
                            Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
                        <Button Content="Generate next-level forms"
                    Click="GenerateFormsFromForm_Click"
                    Padding="12,8"
                    Margin="0,0,8,0"/>

                        <Button Content="Add selected form to dictionary"
                    Click="AddForm_Click"
                    Padding="12,8"
                    Margin="0,0,8,0"/>

                        <Button Content="Delete selected"
                    Click="DeleteForm_Click"
                    Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ROOTS -->
            <TabItem Header="Roots">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="RootsGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Root symbol"/>
                        <TextBox x:Name="RootTextBox"
                                 Margin="0,4,0,0"
                                 MaxLength="200"/>
                        <TextBox
                                x:Name="RootTranslateBox"
                                Width="150"
                                Height="30"
                                Margin="5"
                                ToolTip="Translation of root"/>     
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Add"
                                Click="AddRoot_Click"
                                Padding="18,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Delete selected"
                                Click="DeleteRoot_Click"
                                Padding="18,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Generate roots"
                                Click="GenerateRoots_Click"
                                Padding="18,8"/>
                        <Button Content="Generate first-level forms"
                                Click="GenerateForms_Click"
                                Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>



            <!-- DICTIONARY -->
            <TabItem Header="Dictionary">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="WordsGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                        Margin="0,0,8,0">
                            <TextBlock Text="Word"/>
                            <TextBox x:Name="WordTextBox"
                         Margin="0,4,0,0"
                         MaxLength="200"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                        Margin="8,0,0,0">
                            <TextBlock Text="Translation"/>
                            <TextBox x:Name="WordTranslateBox"
                         Margin="0,4,0,0"
                         MaxLength="200"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
                        <Button Content="Add"
                    Click="AddWord_Click"
                    Padding="18,8"
                    Margin="0,0,8,0"/>

                        <Button Content="Delete selected"
                    Click="DeleteWord_Click"
                    Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>




            <!-- AFFIXES -->
            <TabItem Header="Affixes">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AffixesGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="230"
                                  Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Affix text"/>
                            <TextBox x:Name="AffixTextBox"
                                     Margin="0,4,0,8"
                                     MaxLength="100"/>

                            <TextBlock Text="Part of speech ID"/>
                            <TextBox x:Name="PartOfSpeechIdBox"
                                     Margin="0,4,0,8"/>

                            <TextBlock Text="Grammatical role code"/>
                            <TextBox x:Name="GrammaticalRoleCodeBox"
                                     Margin="0,4,0,8"/>

                            <TextBlock Text="Affix type ID"/>
                            <TextBox x:Name="AffixTypeIdBox"
                                     Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Add"
                                Click="AddAffix_Click"
                                Padding="18,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Delete selected"
                                Click="DeleteAffix_Click"
                                Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
