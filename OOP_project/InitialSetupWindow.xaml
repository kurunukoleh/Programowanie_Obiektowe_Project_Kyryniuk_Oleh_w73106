<Window x:Class="OOP_project.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaForge — Initial setup"
        Height="260" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="24">
        <TextBlock Text="Konfiguracja LinguaForge"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Liczba symboli alfabetu:"/>
        <TextBox x:Name="AlphabetCountBox"
                 Text="30"
                 Margin="0,5,0,12"/>

        <TextBlock Text="Liczba afiksów:"/>
        <TextBox x:Name="AffixCountBox"
                 Text="20"
                 Margin="0,5,0,16"/>

        <Button Content="Generuj"
                Height="34"
                Click="Generate_Click"/>
    </StackPanel>
</Window>
